{{ 'acs-homepage.css' | asset_url | stylesheet_tag }}
<section class="acs-memberships"><div class="acs-container acs-memberships__inner"><div class="acs-memberships__grid">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<div class="acs-membership-card">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 280 | image_tag: loading: 'lazy', alt: block.settings.name }}{% endif %}</div>{% endfor %}{% else %}{% assign membership_files = 'asm-1.jpg,aws-1.jpg,isa-1.jpg,nfib-1.jpg,AWS-ITSA-logo-revised.jpg,Aviation-Week.jpg' | split: ',' %}{% for file in membership_files %}<div class="acs-membership-card"><img src="https://store.alloycoatingsupply.com/wp-content/uploads/2018/06/{{ file }}" alt="Membership" width="120" height="84" loading="lazy"></div>{% endfor %}{% endif %}</div></div></section>
{% schema %}{"name":"ACS memberships","blocks":[{"type":"logo","name":"Membership logo","settings":[{"type":"image_picker","id":"image","label":"Logo"},{"type":"text","id":"name","label":"Name"}]}],"presets":[{"name":"ACS memberships"}]}{% endschema %}
