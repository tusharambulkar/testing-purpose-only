{{ 'acs-homepage.css' | asset_url | stylesheet_tag }}
<section class="acs-hero acs-hero-section">
  {% for block in section.blocks %}
    <div class="acs-slide {% if forloop.first %}is-active{% endif %}">
      <div class="acs-slide__image" {% if block.settings.image != blank %}style="background-image:url('{{ block.settings.image | image_url: width: 1920 }}')"{% endif %}></div><div class="acs-slide__shade"></div>
      <div class="acs-container acs-slide__content"><span class="acs-slide__eyebrow">{{ block.settings.eyebrow }}</span><h1>{{ block.settings.heading }}</h1><div class="acs-slide__buttons">{% if block.settings.primary_label != blank %}<a class="acs-button acs-button--light" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label }}</a>{% endif %}{% if block.settings.phone != blank %}<a class="acs-button acs-button--outline-light" href="tel:{{ block.settings.phone | replace: ' ', '' }}">{{ block.settings.phone }}</a>{% endif %}</div></div>
    </div>
  {% endfor %}
  <div class="acs-container acs-hero__controls"><div class="acs-hero__dots">{% for block in section.blocks %}<button class="{% if forloop.first %}is-active{% endif %}" type="button" aria-label="Slide {{ forloop.index }}"><span></span></button>{% endfor %}</div><button class="acs-circle-button" type="button" data-acs-prev aria-label="Previous slide">&larr;</button><button class="acs-circle-button" type="button" data-acs-next aria-label="Next slide">&rarr;</button></div>
</section>
<script src="{{ 'acs-homepage.js' | asset_url }}" defer></script>
{% schema %}{"name":"ACS hero","blocks":[{"type":"slide","name":"Slide","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"We Are The Solutions Experts"},{"type":"text","id":"heading","label":"Heading","default":"Robotic automation thermal spray booth integrations"},{"type":"text","id":"primary_label","label":"Primary button","default":"Get more info"},{"type":"url","id":"primary_link","label":"Primary button link"},{"type":"text","id":"phone","label":"Phone button","default":"Call (281) 528-0980"}]}],"presets":[{"name":"ACS hero","blocks":[{"type":"slide","settings":{"heading":"Robotic automation thermal spray booth integrations"}},{"type":"slide","settings":{"eyebrow":"ACS / FS-Maschinenbau","heading":"Mass Flow HVOF for Feed Screws"}},{"type":"slide","settings":{"eyebrow":"We are the Rotor & Stator Experts","heading":"Ask us about our proven solutions!"}}]}]}{% endschema %}
