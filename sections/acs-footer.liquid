{{ 'acs-homepage.css' | asset_url | stylesheet_tag }}
<footer class="acs-footer"><div class="acs-footer__inner"><div class="acs-footer__newsletter"><div><strong>{{ section.settings.heading }}</strong><span>{{ section.settings.text }}</span></div>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Email address" required><button type="submit">Subscribe</button>{% endform %}</div><div class="acs-footer__grid">{% for block in section.blocks %}<div><strong>{{ block.settings.heading }}</strong>{% for i in (1..5) %}{% assign label_key = 'link_' | append: i %}{% assign url_key = 'url_' | append: i %}{% assign label = block.settings[label_key] %}{% assign url = block.settings[url_key] %}{% if label != blank %}<a href="{{ url | default: '#' }}">{{ label }}</a>{% endif %}{% endfor %}</div>{% else %}<div><strong>Shop</strong><a href="/collections/abrasives">Abrasives</a><a href="/collections/abrasive-power-tools">Abrasive Power Tools</a><a href="/collections/thermal-spray">Thermal Spray</a></div><div><strong>Customer Support</strong><a href="/pages/about-us">About Us</a><a href="/pages/contact">Contact Us</a><a href="/account">Track Your Order</a></div><div><strong>Policies</strong><a href="/policies/privacy-policy">Privacy Policy</a><a href="/policies/refund-policy">Return Policy</a><a href="/policies/shipping-policy">Shipping Policy</a></div>{% endfor %}<div><strong>Contact</strong><a href="tel:2815280980">(281) 528-0980</a><span>8am-5pm (CST), Mon.-Fri.</span><a href="mailto:info@alloycoatingsupply.com">info@alloycoatingsupply.com</a></div></div><div style="border-top:1px solid #33363b;padding-top:24px">Copyright {{ 'now' | date: '%Y' }} &copy; {{ shop.name }}. All Rights Reserved.</div></div></footer><div class="acs-cart-overlay" data-acs-cart-close></div><aside class="acs-cart-drawer" aria-label="Cart drawer"><div class="acs-cart-drawer__head"><strong>Your cart ({{ cart.item_count }})</strong><button type="button" data-acs-cart-close aria-label="Close">&times;</button></div><div class="acs-cart-drawer__body" data-acs-cart-body>{% if cart.item_count == 0 %}<div class="acs-cart-empty">No products in the cart.</div>{% else %}{% for item in cart.items %}<article class="acs-cart-item" data-acs-cart-key="{{ item.key }}"><img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title }}" width="80" height="80"><div><strong>{{ item.product.title }}</strong><span>{{ item.variant.title }}</span><div class="acs-cart-item__controls"><button type="button" data-acs-cart-change="-1">&minus;</button><span>{{ item.quantity }}</span><button type="button" data-acs-cart-change="1">+</button></div></div></article>{% endfor %}{% endif %}</div><div class="acs-cart-drawer__footer"><div><span>Subtotal</span><strong data-acs-cart-subtotal>{{ cart.total_price | money }}</strong></div><a class="acs-cart-checkout" href="/checkout">Checkout</a></div></aside>
{% schema %}{"name":"ACS footer","settings":[{"type":"text","id":"heading","label":"Newsletter heading","default":"Subscribe to our newsletter"},{"type":"text","id":"text","label":"Newsletter text","default":"New products, sale items and thermal spray updates."}],"blocks":[{"type":"menu","name":"Footer menu","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"text","id":"link_1","label":"Link 1"},{"type":"url","id":"url_1","label":"URL 1"},{"type":"text","id":"link_2","label":"Link 2"},{"type":"url","id":"url_2","label":"URL 2"},{"type":"text","id":"link_3","label":"Link 3"},{"type":"url","id":"url_3","label":"URL 3"},{"type":"text","id":"link_4","label":"Link 4"},{"type":"url","id":"url_4","label":"URL 4"},{"type":"text","id":"link_5","label":"Link 5"},{"type":"url","id":"url_5","label":"URL 5"}]}],"presets":[{"name":"ACS footer","blocks":[{"type":"menu","settings":{"heading":"Shop"}},{"type":"menu","settings":{"heading":"Customer Support"}},{"type":"menu","settings":{"heading":"Policies"}}]}]}{% endschema %}
