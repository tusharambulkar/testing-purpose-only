{{ 'acs-homepage.css' | asset_url | stylesheet_tag }}
<section class="acs-thermal"><div class="acs-thermal__inner"><div><span class="acs-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2>{% if section.settings.image != blank %}<div class="acs-thermal__image">{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.heading }}</div>{% else %}<div class="acs-thermal__image"><img src="https://store.alloycoatingsupply.com/wp-content/uploads/2018/07/IMG_0230-1067x800.jpg" alt="Thermal spray rotor" width="1067" height="800" loading="lazy"></div>{% endif %}</div><div><div class="acs-spares">{% if section.blocks.size > 0 %}{% for block in section.blocks %}<a href="{{ block.settings.link }}"><span>{{ block.settings.heading }}</span><span>&rarr;</span></a>{% endfor %}{% else %}{% assign spares = 'HVOF 5000 Gun Spares,Diamond Jet Gun Spares,SG-100 Gun Spares,Coating Equipment,Flexicords,Rokide Rods,Powder Feeders,Robotic Power Tools' | split: ',' %}{% for spare in spares %}<a href="/collections/thermal-spray"><span>{{ spare }}</span><span>&rarr;</span></a>{% endfor %}{% endif %}</div><div style="margin-top:28px;display:flex;gap:12px"><a class="acs-button acs-button--light" href="{{ section.settings.primary_link }}">Shop Thermal Spray</a><a class="acs-button acs-button--outline-light" href="{{ section.settings.secondary_link }}">View all powders...</a></div></div></div></section>
{% schema %}{"name":"ACS thermal spray","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Thermal Spray Equipment & Spares"},{"type":"text","id":"heading","label":"Heading","default":"Spares and consumables for the guns you already run."},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"blocks":[{"type":"link","name":"Link","settings":[{"type":"text","id":"heading","label":"Name"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"ACS thermal spray","blocks":[{"type":"link","settings":{"heading":"HVOF 5000 Gun Spares"}},{"type":"link","settings":{"heading":"Diamond Jet Gun Spares"}},{"type":"link","settings":{"heading":"SG-100 Gun Spares"}},{"type":"link","settings":{"heading":"Coating Equipment"}},{"type":"link","settings":{"heading":"Flexicords"}},{"type":"link","settings":{"heading":"Rokide Rods"}},{"type":"link","settings":{"heading":"Powder Feeders"}},{"type":"link","settings":{"heading":"Robotic Power Tools"}}]}]}{% endschema %}
