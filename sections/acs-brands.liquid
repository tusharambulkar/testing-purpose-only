{{ 'acs-homepage.css' | asset_url | stylesheet_tag }}
<section class="acs-brands"><div class="acs-brands__inner"><div class="acs-section-heading"><div><span class="acs-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div><a href="{{ section.settings.view_all_link }}">All brands</a></div><div class="acs-brand-grid">{% for block in section.blocks %}<a href="{{ block.settings.link }}">{{ block.settings.name }}</a>{% else %}{% assign names = 'ACS,Binks,3M,DeVilbiss,Dewal Industries Inc.,Dynabrade,Dynabrade Nitro Series,INSIZE,National Detroit,Norton,Saint-Gobain,Standard Abrasives' | split: ',' %}{% for name in names %}<a href="/collections/all">{{ name }}</a>{% endfor %}{% endfor %}</div></div></section>
{% schema %}{"name":"ACS brands","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Brands we carry"},{"type":"text","id":"heading","label":"Heading","default":"Shop by brand"},{"type":"url","id":"view_all_link","label":"All brands link"}],"blocks":[{"type":"brand","name":"Brand","settings":[{"type":"text","id":"name","label":"Brand name"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"ACS brands","blocks":[{"type":"brand","settings":{"name":"ACS"}},{"type":"brand","settings":{"name":"Binks"}},{"type":"brand","settings":{"name":"3M"}},{"type":"brand","settings":{"name":"DeVilbiss"}},{"type":"brand","settings":{"name":"Dewal Industries, Inc."}},{"type":"brand","settings":{"name":"Dynabrade"}}]}]}{% endschema %}
