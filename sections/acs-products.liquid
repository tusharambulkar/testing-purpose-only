{{ 'acs-homepage.css' | asset_url | stylesheet_tag }}
<section class="acs-products"><div class="acs-products__inner"><div class="acs-product-tabs"><div class="acs-product-tabs__buttons"><button class="is-active" type="button" data-acs-tab="featured">Featured Products</button><button type="button" data-acs-tab="bestsellers">Best Sellers</button></div>{% if section.settings.collection != blank %}<a href="{{ section.settings.collection.url }}">Browse All</a>{% endif %}</div><div class="acs-product-grid" data-acs-product-grid="featured">{% assign selected = section.settings.collection | default: collections.all %}{% for product in selected.products limit: section.settings.limit %}<article class="acs-product-card"><a class="acs-product-card__image" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</a><div class="acs-product-card__body"><div class="acs-product-card__meta"><span>{{ product.vendor }}</span><span>#{{ product.selected_or_first_available_variant.sku }}</span></div><a class="acs-product-card__title" href="{{ product.url }}">{{ product.title }}</a><div class="acs-product-card__price">{{ product.price | money }}</div><form method="post" action="/cart/add" data-acs-add-form><input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><button class="acs-add" type="submit">Add to cart</button></form></div></article>{% endfor %}</div></div></section>
<script src="{{ 'acs-homepage.js' | asset_url }}" defer></script>
{% schema %}{"name":"ACS featured products","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":4,"max":12,"step":1,"default":6}],"presets":[{"name":"ACS featured products"}]}{% endschema %}
