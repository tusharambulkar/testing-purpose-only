{{ 'acs-homepage.css' | asset_url | stylesheet_tag }}
<section class="acs-section"><div class="acs-section-heading"><div><span class="acs-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2></div><a href="{{ section.settings.view_all_link }}">View all categories</a></div><div class="acs-categories">{% for block in section.blocks %}<article class="acs-category"><a class="acs-category__image" href="{{ block.settings.link }}">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.heading }}{% endif %}</a><a class="acs-category__name" href="{{ block.settings.link }}">{{ block.settings.heading }} <span>&rarr;</span></a><div class="acs-category__subs"><span>{{ block.settings.item_1 }}</span><span>{{ block.settings.item_2 }}</span></div></article>{% else %}<article class="acs-category"><a class="acs-category__name" href="/collections/abrasives">Abrasives &rarr;</a></article><article class="acs-category"><a class="acs-category__name" href="/collections/abrasive-power-tools">Abrasive Power Tools &rarr;</a></article><article class="acs-category"><a class="acs-category__name" href="/collections/automotive">Automotive Aftermarket &rarr;</a></article><article class="acs-category"><a class="acs-category__name" href="/collections/masking-materials">Masking Materials &rarr;</a></article><article class="acs-category"><a class="acs-category__name" href="/collections/measuring-inspection">Measuring / Inspection &rarr;</a></article><article class="acs-category"><a class="acs-category__name" href="/collections/thermal-spray">Thermal Spray Equipment & Spares &rarr;</a></article>{% endfor %}</div></section>
{% schema %}{"name":"ACS categories","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Browse the catalog"},{"type":"text","id":"heading","label":"Heading","default":"Shop by category"},{"type":"url","id":"view_all_link","label":"View all link"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Name"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"item_1","label":"Link 1"},{"type":"text","id":"item_2","label":"Link 2"}]}],"presets":[{"name":"ACS categories","blocks":[{"type":"category","settings":{"heading":"Abrasives"}},{"type":"category","settings":{"heading":"Abrasive Power Tools"}},{"type":"category","settings":{"heading":"Automotive Aftermarket"}},{"type":"category","settings":{"heading":"Masking Materials"}},{"type":"category","settings":{"heading":"Measuring / Inspection"}},{"type":"category","settings":{"heading":"Thermal Spray Equipment & Spares"}}]}]}{% endschema %}
