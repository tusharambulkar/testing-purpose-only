{{ 'acs-homepage.css' | asset_url | stylesheet_tag }}
<section class="acs-about"><div class="acs-about__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.heading }}{% endif %}</div><div><span class="acs-kicker">{{ section.settings.eyebrow }}</span><h2>{{ section.settings.heading }}</h2><div class="acs-about__body">{{ section.settings.text }}</div><div style="margin-top:18px"><a class="acs-button" style="background:#17191c;color:#fff" href="{{ section.settings.primary_link }}">About Us</a> <a class="acs-button" style="border-color:#17191c" href="{{ section.settings.secondary_link }}">Testimonials</a></div></div></section>
{% schema %}{"name":"ACS about","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"About Us"},{"type":"text","id":"heading","label":"Heading","default":"Customer Built. Customer Focused."},{"type":"richtext","id":"text","label":"Text"},{"type":"url","id":"primary_link","label":"About link"},{"type":"url","id":"secondary_link","label":"Testimonials link"}],"presets":[{"name":"ACS about"}]}{% endschema %}
