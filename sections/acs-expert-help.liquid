{{ 'acs-homepage.css' | asset_url | stylesheet_tag }}
<section class="acs-expert"><div class="acs-expert__inner"><div><span>{{ section.settings.eyebrow }}</span><h2 style="font-size:46px;margin:12px 0 0">{{ section.settings.heading }}</h2></div><div><a href="tel:{{ section.settings.phone | replace: ' ', '' }}" style="display:block;font-size:36px;font-weight:800">{{ section.settings.phone }}</a><span>{{ section.settings.hours }}</span></div><a class="acs-button acs-button--light" href="{{ section.settings.link }}">{{ section.settings.button_label }}</a></div></section>
{% schema %}{"name":"ACS expert help","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"We Are The Solutions Experts"},{"type":"text","id":"heading","label":"Heading","default":"Can't find the part you need? Talk to our team."},{"type":"text","id":"phone","label":"Phone","default":"(281) 528-0980"},{"type":"text","id":"hours","label":"Hours","default":"8am-5pm (CST), Mon.-Fri."},{"type":"text","id":"button_label","label":"Button","default":"Contact Us"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"ACS expert help"}]}{% endschema %}
